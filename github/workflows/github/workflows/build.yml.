
name: Build PINTJI PAY APK

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable

      - name: Create Flutter project
        run: |
          flutter create --org com.pintjipay --project-name pintji_pay --platforms android pintji_pay

      - name: Create PINTJI PAY app
        run: |
          cat > pintji_pay/lib/main.dart <<'DART'
          import 'package:flutter/material.dart';

          void main() => runApp(const PintjiPay());

          class PintjiPay extends StatelessWidget {
            const PintjiPay({super.key});

            @override
            Widget build(BuildContext context) {
              return MaterialApp(
                debugShowCheckedModeBanner: false,
                title: 'PINTJI PAY',
                theme: ThemeData(
                  colorScheme: ColorScheme.fromSeed(
                    seedColor: const Color(0xFF1769E0),
                  ),
                  scaffoldBackgroundColor: const Color(0xFFF3F7FD),
                  useMaterial3: true,
                ),
                home: const HomePage(),
              );
            }
          }

          class HomePage extends StatefulWidget {
            const HomePage({super.key});

            @override
            State<HomePage> createState() => _HomePageState();
          }

          class _HomePageState extends State<HomePage> {
            int tab = 0;
            int balance = 250000;

            final services = const [
              ['Transfer', Icons.send_rounded],
              ['QRIS', Icons.qr_code_2_rounded],
              ['Tagihan', Icons.receipt_long_rounded],
              ['Pulsa/Data', Icons.phone_android_rounded],
              ['Token Listrik', Icons.bolt_rounded],
              ['Reksa Dana', Icons.trending_up_rounded],
              ['Top Up', Icons.add_card_rounded],
              ['Keamanan', Icons.shield_outlined],
            ];

            String rupiah(int n) {
              final s = n.toString();
              final result = StringBuffer();
              for (int i = 0; i < s.length; i++) {
                result.write(s[i]);
                final left = s.length - i - 1;
                if (left > 0 && left % 3 == 0) result.write('.');
              }
              return 'Rp$result';
            }

            void showService(String name) {
              if (name == 'Top Up') {
                setState(() => balance += 50000);
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(
                    content: Text('Top Up demo +Rp50.000'),
                  ),
                );
              } else {
                showDialog<void>(
                  context: context,
                  builder: (context) => AlertDialog(
                    title: Text(name),
                    content: Text(
                      '$name masih berupa demo. '
                      'Pembayaran asli belum terhubung.',
                    ),
                    actions: [
                      TextButton(
                        onPressed: () => Navigator.pop(context),
                        child: const Text('Tutup'),
                      ),
                    ],
                  ),
                );
              }
            }

            @override
            Widget build(BuildContext context) {
              return Scaffold(
                appBar: AppBar(
                  title: const Text(
                    'PINTJI PAY',
                    style: TextStyle(fontWeight: FontWeight.w900),
                  ),
                  actions: [
                    IconButton(
                      onPressed: () => showService('Notifikasi'),
                      icon: const Icon(Icons.notifications_none),
                    ),
                  ],
                ),
                body: IndexedStack(
                  index: tab,
                  children: [
                    ListView(
                      padding: const EdgeInsets.all(18),
                      children: [
                        Container(
                          padding: const EdgeInsets.all(24),
                          decoration: BoxDecoration(
                            gradient: const LinearGradient(
                              colors: [
                                Color(0xFF123A72),
                                Color(0xFF1769E0),
                              ],
                            ),
                            borderRadius: BorderRadius.circular(24),
                          ),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              const Text(
                                'TOTAL SALDO DEMO',
                                style: TextStyle(color: Colors.white70),
                              ),
                              const SizedBox(height: 12),
                              Text(
                                rupiah(balance),
                                style: const TextStyle(
                                  color: Colors.white,
                                  fontSize: 30,
                                  fontWeight: FontWeight.bold,
                                ),
                              ),
                              const SizedBox(height: 18),
                              const Text(
                                'Akun simulasi • Bukan uang asli',
                                style: TextStyle(color: Colors.white70),
                              ),
                              const SizedBox(height: 16),
                              FilledButton.icon(
                                onPressed: () => showService('Top Up'),
                                icon: const Icon(Icons.add),
                                label: const Text('Top Up Demo'),
                              ),
                            ],
                          ),
                        ),
                        const SizedBox(height: 26),
                        const Text(
                          'Menu utama',
                          style: TextStyle(
                            fontSize: 20,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        const SizedBox(height: 16),
                        GridView.builder(
                          shrinkWrap: true,
                          physics: const NeverScrollableScrollPhysics(),
                          itemCount: services.length,
                          gridDelegate:
                              const SliverGridDelegateWithFixedCrossAxisCount(
                            crossAxisCount: 4,
                            mainAxisSpacing: 18,
                            crossAxisSpacing: 8,
                            childAspectRatio: 0.72,
                          ),
                          itemBuilder: (context, index) {
                            final item = services[index];
                            return InkWell(
                              onTap: () => showService(item[0] as String),
                              child: Column(
                                children: [
                                  Container(
                                    width: 56,
                                    height: 56,
                                    decoration: BoxDecoration(
                                      color: Colors.white,
                                      borderRadius: BorderRadius.circular(18),
                                    ),
                                    child: Icon(
                                      item[1] as IconData,
                                      color: const Color(0xFF1769E0),
                                      size: 28,
                                    ),
                                  ),
                                  const SizedBox(height: 8),
                                  Text(
                                    item[0] as String,
                                    textAlign: TextAlign.center,
                                    style: const TextStyle(fontSize: 11),
                                  ),
                                ],
                              ),
                            );
                          },
                        ),
                        const SizedBox(height: 24),
                        const Text(
                          'Aktivitas terbaru',
                          style: TextStyle(
                            fontSize: 20,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        const Card(
                          child: ListTile(
                            leading: Icon(Icons.add_circle_outline),
                            title: Text('Saldo awal demo'),
                            subtitle: Text('Transaksi simulasi'),
                            trailing: Text('+Rp250.000'),
                          ),
                        ),
                      ],
                    ),
                    const Center(
                      child: Text(
                        'Riwayat transaksi demo',
                        style: TextStyle(fontSize: 18),
                      ),
                    ),
                    const Center(
                      child: Text(
                        'Akun PINTJI PAY\nVersi prototipe',
                        textAlign: TextAlign.center,
                        style: TextStyle(fontSize: 20),
                      ),
                    ),
                  ],
                ),
                bottomNavigationBar: NavigationBar(
                  selectedIndex: tab,
                  onDestinationSelected: (value) {
                    setState(() => tab = value);
                  },
                  destinations: const [
                    NavigationDestination(
                      icon: Icon(Icons.home_outlined),
                      label: 'Beranda',
                    ),
                    NavigationDestination(
                      icon: Icon(Icons.receipt_long_outlined),
                      label: 'Aktivitas',
                    ),
                    NavigationDestination(
                      icon: Icon(Icons.person_outline),
                      label: 'Akun',
                    ),
                  ],
                ),
              );
            }
          }
          DART

      - name: Install dependencies
        run: cd pintji_pay && flutter pub get

      - name: Analyze
        run: cd pintji_pay && flutter analyze

      - name: Build APK
        run: cd pintji_pay && flutter build apk --release

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: PINTJI-PAY-APK
          path: pintji_pay/build/app/outputs/flutter-apk/app-release.apk
          
