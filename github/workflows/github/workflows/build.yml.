
name: Build PINTJI PAY APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Create Flutter project
        run: |
          flutter create --platforms=android pintji_pay
          cd pintji_pay
          flutter pub add supabase_flutter

      - name: Configure Supabase app
        env:
          SUPABASE_URL: https://mnzkwajngdkwrylammqj.supabase.co
          SUPABASE_PUBLISHABLE_KEY: ${{ secrets.SUPABASE_PUBLISHABLE_KEY }}
        run: |
          cd pintji_pay
          cat > lib/main.dart <<'DART'
          import 'package:flutter/material.dart';
          import 'package:supabase_flutter/supabase_flutter.dart';

          Future<void> main() async {
            WidgetsFlutterBinding.ensureInitialized();

            await Supabase.initialize(
              url: const String.fromEnvironment('SUPABASE_URL'),
              anonKey: const String.fromEnvironment(
                'SUPABASE_PUBLISHABLE_KEY',
              ),
            );

            runApp(const PintjiPayApp());
          }

          class PintjiPayApp extends StatelessWidget {
            const PintjiPayApp({super.key});

            @override
            Widget build(BuildContext context) {
              return MaterialApp(
                title: 'PINTJI PAY',
                debugShowCheckedModeBanner: false,
                theme: ThemeData(
                  colorScheme: ColorScheme.fromSeed(
                    seedColor: Colors.blue,
                  ),
                  useMaterial3: true,
                ),
                home: const HomePage(),
              );
            }
          }

          class HomePage extends StatelessWidget {
            const HomePage({super.key});

            Future<List<Map<String, dynamic>>> loadProducts() async {
              return await Supabase.instance.client
                  .from('products')
                  .select('id, name, category, price')
                  .eq('is_active', true);
            }

            @override
            Widget build(BuildContext context) {
              return Scaffold(
                appBar: AppBar(title: const Text('PINTJI PAY')),
                body: FutureBuilder<List<Map<String, dynamic>>>(
                  future: loadProducts(),
                  builder: (context, snapshot) {
                    if (snapshot.connectionState ==
                        ConnectionState.waiting) {
                      return const Center(
                        child: CircularProgressIndicator(),
                      );
                    }

                    if (snapshot.hasError) {
                      return const Center(
                        child: Text('Produk gagal dimuat. Periksa koneksi.'),
                      );
                    }

                    final products = snapshot.data ?? [];

                    if (products.isEmpty) {
                      return const Center(
                        child: Text('Belum ada produk aktif.'),
                      );
                    }

                    return ListView.builder(
                      itemCount: products.length,
                      itemBuilder: (context, index) {
                        final product = products[index];
                        return ListTile(
                          title: Text(product['name'].toString()),
                          subtitle: Text(
                            product['category'].toString(),
                          ),
                          trailing: Text(
                            'Rp ${product['price']}',
                          ),
                        );
                      },
                    );
                  },
                ),
              );
            }
          }
          DART

      - name: Build APK
        env:
          SUPABASE_URL: https://mnzkwajngdkwrylammqj.supabase.co
          SUPABASE_PUBLISHABLE_KEY: ${{ secrets.SUPABASE_PUBLISHABLE_KEY }}
        run: |
          cd pintji_pay
          flutter build apk --release \
            --dart-define=SUPABASE_URL="$SUPABASE_URL" \
            --dart-define=SUPABASE_PUBLISHABLE_KEY="$SUPABASE_PUBLISHABLE_KEY"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: pintji-pay-apk
          path: pintji_pay/build/app/outputs/flutter-apk/app-release.apk

